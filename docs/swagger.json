{
  "openapi": "3.0.0",
  "info": {
    "title": "Biblioteca API",
    "version": "1.0.0",
    "description": "API de gerenciamento de biblioteca com CRUD de livros, autores, categorias, cópias, reservas, usuários e autenticação JWT. Fonte da verdade para o frontend em Next.js deste repositório."
  },
  "servers": [{ "url": "http://localhost:3333/api", "description": "Produção (Vercel)" }],
  "tags": [
    { "name": "Auth" },
    { "name": "Books" },
    { "name": "Copies" },
    { "name": "Reservations" },
    { "name": "Authors" },
    { "name": "Categories" },
    { "name": "Users" }
  ],
  "paths": {
    "/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Login bem-sucedido",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
            }
          }
        }
      }
    },
    "/books": {
      "get": {
        "tags": ["Books"],
        "summary": "Listar livros (?page &limit &categoryId &authorId)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" } },
          { "name": "authorId", "in": "query", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Lista paginada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Book" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Books"],
        "summary": "Criar livro",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/BookInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Book" } }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ValidationError" } }
            }
          }
        }
      }
    },
    "/books/{id}": {
      "get": {
        "tags": ["Books"],
        "summary": "Buscar livro por ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          },
          "404": {
            "description": "Não encontrado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          }
        }
      },
      "put": {
        "tags": ["Books"],
        "summary": "Atualizar livro",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BookInput" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Book" } } }
          }
        }
      },
      "delete": {
        "tags": ["Books"],
        "summary": "Remover livro",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removido" } }
      }
    },
    "/authors": {
      "get": {
        "tags": ["Authors"],
        "summary": "Listar autores (?page &limit)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Author" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Authors"],
        "summary": "Criar autor (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorInput" } } }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Author" } } }
          }
        }
      }
    },
    "/authors/{id}": {
      "get": {
        "tags": ["Authors"],
        "summary": "Buscar autor por ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Author" } } }
          }
        }
      },
      "put": {
        "tags": ["Authors"],
        "summary": "Atualizar autor (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthorInput" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Author" } } }
          }
        }
      },
      "delete": {
        "tags": ["Authors"],
        "summary": "Remover autor (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removido" } }
      }
    },
    "/categories": {
      "get": {
        "tags": ["Categories"],
        "summary": "Listar categorias (?page &limit)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Categories"],
        "summary": "Criar categoria (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          }
        }
      }
    },
    "/categories/{id}": {
      "get": {
        "tags": ["Categories"],
        "summary": "Buscar categoria por ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          }
        }
      },
      "put": {
        "tags": ["Categories"],
        "summary": "Atualizar categoria (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CategoryInput" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Category" } } }
          }
        }
      },
      "delete": {
        "tags": ["Categories"],
        "summary": "Remover categoria (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removida" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users"],
        "summary": "Listar usuários (auth)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/User" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users"],
        "summary": "Criar usuário (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } } }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users"],
        "summary": "Buscar usuário por ID (auth)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      },
      "put": {
        "tags": ["Users"],
        "summary": "Atualizar usuário (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserUpdateInput" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          }
        }
      },
      "delete": {
        "tags": ["Users"],
        "summary": "Remover usuário (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removido" } }
      }
    },
    "/copies": {
      "get": {
        "tags": ["Copies"],
        "summary": "Listar cópias (?page &limit &bookId &status)",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "bookId", "in": "query", "schema": { "type": "integer" } },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["AVAILABLE", "BORROWED", "MAINTENANCE", "LOST", "RESERVED"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Copy" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Copies"],
        "summary": "Criar cópia (admin)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CopyInput" } } }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Copy" } } }
          }
        }
      }
    },
    "/copies/{id}": {
      "get": {
        "tags": ["Copies"],
        "summary": "Buscar cópia por ID",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Copy" } } }
          }
        }
      },
      "put": {
        "tags": ["Copies"],
        "summary": "Atualizar cópia (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CopyInput" } } }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Copy" } } }
          }
        }
      },
      "delete": {
        "tags": ["Copies"],
        "summary": "Remover cópia (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removida" } }
      }
    },
    "/reservations": {
      "get": {
        "tags": ["Reservations"],
        "summary": "Listar reservas (?page &limit &status). Admin vê todas; user vê as suas.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          {
            "name": "status",
            "in": "query",
            "schema": { "type": "string", "enum": ["PENDING", "PICKED_UP", "CANCELLED", "EXPIRED"] }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Reservation" } },
                    "pagination": { "$ref": "#/components/schemas/Pagination" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Reservations"],
        "summary": "Reservar cópia (expira em 24h)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReservationInput" } } }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } }
          }
        }
      }
    },
    "/reservations/{id}": {
      "get": {
        "tags": ["Reservations"],
        "summary": "Buscar reserva por ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } }
          }
        }
      },
      "put": {
        "tags": ["Reservations"],
        "summary": "Atualizar status (admin): PICKED_UP | CANCELLED | EXPIRED",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": { "type": "string", "enum": ["PICKED_UP", "CANCELLED", "EXPIRED"] }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Reservation" } } }
          }
        }
      },
      "delete": {
        "tags": ["Reservations"],
        "summary": "Remover reserva (admin)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "204": { "description": "Removida" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Book": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "year": { "type": "integer" },
          "authorId": { "type": "integer" },
          "Author": { "$ref": "#/components/schemas/Author" },
          "categoryId": { "type": "integer", "nullable": true },
          "Category": { "$ref": "#/components/schemas/Category" }
        }
      },
      "BookInput": {
        "type": "object",
        "required": ["title", "authorId", "year"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "authorId": { "type": "integer", "minimum": 1 },
          "year": { "type": "integer" },
          "categoryId": { "type": "integer", "minimum": 1, "nullable": true }
        }
      },
      "Author": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
      },
      "AuthorInput": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      },
      "Category": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "name": { "type": "string" } }
      },
      "CategoryInput": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "role": { "type": "string", "enum": ["user", "admin"], "default": "user" }
        }
      },
      "UserUpdateInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "minLength": 6 },
          "role": { "type": "string", "enum": ["user", "admin"] }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "Copy": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["AVAILABLE", "BORROWED", "MAINTENANCE", "LOST", "RESERVED"]
          },
          "bookId": { "type": "integer" },
          "Book": { "$ref": "#/components/schemas/Book" }
        }
      },
      "CopyInput": {
        "type": "object",
        "required": ["code", "bookId"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "status": {
            "type": "string",
            "enum": ["AVAILABLE", "BORROWED", "MAINTENANCE", "LOST", "RESERVED"],
            "default": "AVAILABLE"
          },
          "bookId": { "type": "integer", "minimum": 1 }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "userId": { "type": "integer" },
          "User": { "$ref": "#/components/schemas/User" },
          "copyId": { "type": "integer" },
          "Copy": { "$ref": "#/components/schemas/Copy" },
          "status": { "type": "string", "enum": ["PENDING", "PICKED_UP", "CANCELLED", "EXPIRED"] },
          "reservedAt": { "type": "string", "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "pickedUpAt": { "type": "string", "format": "date-time", "nullable": true },
          "returnedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "ReservationInput": {
        "type": "object",
        "required": ["copyId"],
        "properties": { "copyId": { "type": "integer", "minimum": 1 } }
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      },
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
